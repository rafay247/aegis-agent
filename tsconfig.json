{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `evals/` and `scripts/` import devDependencies (openai, autoevals, tsx).
  // `next build` type-checks everything this `include` matches, so leaving them
  // in would make a production install (`npm ci --omit=dev`) fail the build on
  // unresolvable modules that the app itself never imports. They are still
  // type-checked — via `tsconfig.tools.json` / `npm run typecheck:tools`.
  "exclude": ["node_modules", "evals", "scripts"]
}
